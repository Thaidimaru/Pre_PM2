{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- ./src ./public ./api ./package.json ./vite.config.mjs ./vercel.json ./index.html",
  "functions": {
    "api/*.js": {
      "includeFiles": "{DATABASE.xlsx,AGWBS.xlsx,access-password.txt,data/seed_surveys.json,survey-*.json,data/surveys/**}"
    }
  },
  "rewrites": [
    { "source": "/access-password.txt", "destination": "/404" },
    { "source": "/github-token.txt", "destination": "/404" },
    { "source": "/survey.db", "destination": "/404" },
    { "source": "/DATABASE.xlsx", "destination": "/404" },
    { "source": "/AGWBS.xlsx", "destination": "/404" },
    { "source": "/api/login", "destination": "/api/login" },
    { "source": "/api/database", "destination": "/api/database" },
    { "source": "/api/save", "destination": "/api/save" },
    { "source": "/api/dashboard", "destination": "/api/dashboard" },
    { "source": "/api/github-status", "destination": "/api/github-status" },
    { "source": "/login", "destination": "/api/login" },
    { "source": "/database", "destination": "/api/database" },
    { "source": "/save", "destination": "/api/save" },
    { "source": "/github-status", "destination": "/api/github-status" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/field", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
